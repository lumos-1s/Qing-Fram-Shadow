<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- 清框影 PS 桥接 PoC —— CEP 扩展清单，仅用于验证流程，未签名。 -->
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    ExtensionBundleId="com.qingframe.ps.bridge.poc"
    ExtensionBundleVersion="0.1.0"
    Version="12.0">
  <ExtensionList>
    <Extension Id="com.qingframe.ps.bridge.poc.panel" Version="0.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PHXS" Version="[12.0,30.0]" />
      <Host Name="PHSP" Version="[12.0,30.0]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="12.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.qingframe.ps.bridge.poc.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <!-- cep.fs 需要 Node 上下文，否则面板里 cep 为 undefined，读不到 PS 导出的 PNG -->
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <CommandLine>
          <EnableStyleSheet>true</EnableStyleSheet>
        </CommandLine>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>清框影桥接</Menu>
          <Geometry>
            <Size>
              <Height>480</Height>
              <Width>320</Width>
            </Size>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icon.png</Icon>
            <Icon Type="Rollover">./icon.png</Icon>
            <Icon Type="Disabled">./icon.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
