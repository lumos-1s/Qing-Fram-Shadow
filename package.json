{
  "name": "qingframe-web",
  "version": "0.1.11",
  "description": "本地照片加框工具：艺术边框、光影、文字 Logo、模板与多图拼贴（Electron + Canvas 2D）",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint src --ext .js",
    "validate:presets": "node tools/validate-presets.js",
    "gen:caps": "node tools/gen-style-caps.js",
    "gen:marks": "node tools/gen-marks.js",
    "check:marks": "node tools/gen-marks.js --check",
    "check:caps": "node tools/gen-style-caps.js --check",
    "test:mainio": "node tools/test-main-io.js",
    "test:exifwrite": "node tools/test-exif-write.js",
    "test:icons": "node tools/test-custom-icon-store.js",
    "test:engine": "node tools/test-engine-invariants.js",
    "caps:report": "node tools/gen-style-caps.js --report",
    "test:brand": "node tools/run-electron.js tools/test-brand-logo.js",
    "test:elements": "node tools/run-electron.js tools/test-element-ops.js",
    "test:drag": "node tools/run-electron.js tools/test-element-drag.js",
    "test:logohit": "node tools/run-electron.js tools/test-logo-hit-on-presets.js",
    "test:logodrag": "node tools/run-electron.js tools/test-logo-drag-on-presets.js",
    "test:presetkeep": "node tools/run-electron.js tools/test-preset-keep-content.js",
    "test:shortcut": "node tools/run-electron.js tools/test-shortcut-delete.js",
    "test:imgdel": "node tools/run-electron.js tools/test-image-batch-delete.js",
    "test:avsign": "node tools/run-electron.js tools/test-avatar-sign-bounds.js",
    "test:stampred": "node tools/run-electron.js tools/test-stamp-redseal.js",
    "test:ticketredo": "node tools/run-electron.js tools/test-ticket-redo.js",
    "test:hint": "node tools/run-electron.js tools/test-logo-hint.js",
    "test:position": "node tools/run-electron.js tools/test-element-position.js",
    "test:overlay": "node tools/run-electron.js tools/test-overlay-consistency.js",
    "test:panel": "node tools/run-electron.js tools/test-panel-visibility.js",
    "test:panel:audit": "node tools/run-electron.js tools/test-panel-visibility.js --audit",
    "test:grid:smoke": "node tools/run-electron.js tools/test-grid-crop-smoke.js",
    "test:grid:enhance": "node tools/run-electron.js tools/test-grid-enhance.js",
    "test:grid:five": "node tools/run-electron.js tools/test-grid-five.js",
    "test:grid:bind": "node tools/run-electron.js tools/test-grid-btn-bind.js",
    "test:exif": "node tools/run-electron.js tools/test-export-exif.js",
    "test:contrast": "node tools/run-electron.js tools/test-smart-contrast.js",
    "test:icon:persist": "node tools/run-electron.js tools/test-custom-icon-persist.js",
    "test:puzzle": "node tools/run-electron.js tools/test-puzzle-gap-caption.js",
    "test:puzzlekeep": "node tools/run-electron.js tools/test-puzzle-keep.js",
    "test:label": "node tools/run-electron.js tools/test-param-font-label.js",
    "test:leica": "node tools/run-electron.js tools/test-leica-logo-gap.js",
    "test:pol": "node tools/run-electron.js tools/test-polaroid-hand.js",
    "test:srgb": "node tools/run-electron.js tools/test-export-srgb.js",
    "test:fidelity": "node tools/run-electron.js tools/test-export-fidelity.js",
    "test:grain": "node tools/run-electron.js tools/test-film-grain.js",
    "test:visual": "node tools/run-electron.js tools/visual-regression.js",
    "test": "npm run check && npm run test:brand && npm run test:leica && npm run test:pol && npm run test:grain && npm run test:srgb && npm run test:fidelity && npm run test:elements && npm run test:drag && npm run test:logohit && npm run test:logodrag && npm run test:presetkeep && npm run test:shortcut && npm run test:imgdel && npm run test:avsign && npm run test:stampred && npm run test:ticketredo && npm run test:hint && npm run test:position && npm run test:overlay && npm run test:label && npm run test:panel && npm run test:panel:audit && npm run test:grid:smoke && npm run test:grid:enhance && npm run test:grid:five && npm run test:grid:bind && npm run test:exif && npm run test:contrast && npm run test:icon:persist && npm run test:puzzle && npm run test:puzzlekeep && npm run test:visual",
    "check": "npm run lint && npm run validate:presets && npm run check:caps && npm run check:marks && npm run test:mainio && npm run test:exifwrite && npm run test:icons && npm run test:engine",
    "app:dir": "electron-builder --win --dir",
    "verify:dist": "node tools/verify-dist.js",
    "verify:pkg": "node tools/verify-dist.js --installers",
    "release": "electron-builder --win --dir && node tools/verify-dist.js && electron-builder --win && node tools/verify-dist.js --installers",
    "release:publish": "electron-builder --win --dir && node tools/verify-dist.js && electron-builder --win --publish always && node tools/verify-dist.js --installers",
    "dist": "electron-builder --win && node tools/verify-dist.js --installers",
    "dist:portable": "electron-builder --win portable"
  },
  "author": "lumos",
  "license": "MIT",
  "build": {
    "appId": "com.qingframe.web",
    "productName": "清框影",
    "executableName": "Qingframe",
    "copyright": "Copyright © 2026 清框影",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "shared/**/*",
      "!shared/brandlogos/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "lumos-1s",
        "repo": "Qing-Fram-Shadow-web"
      }
    ],
    "win": {
      "icon": "src/main/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "清框影",
      "artifactName": "Qingframe-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Qingframe-Portable-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "^31.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^8.57.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
